(version 1)
# Custom Design Rules (DRC) for KiCad — Generic: 4 layer, 2oz copper
#
# The strictest of JLCPCB and PCBWay. Every limit is the harder of
# the two, so a board that passes these rules passes at either fab. Use it
# while the fab is still open. Nothing is relaxed to the easier figure, so a
# board built to it can cost more than one built to a single fab's file.
# JLCPCB capabilities: https://jlcpcb.com/capabilities/pcb-capabilities
# PCBWay capabilities: https://www.pcbway.com/capabilities.html
#
# This is the '4L-2oz' variant. If your order differs, use one of
# the other variants (2L-1oz, 4L-1oz, 6L-1oz) — see the README table.
#
# GENERATED FILE — do not edit by hand.
# Derived in code from capabilities/JLCPCB.toml and capabilities/PCBWay.toml by
# tools/generate_dru.py. There is no capabilities/Generic.toml.
#
# Where the fabs give a different width or gap for the same impedance net
# class, the wider track and the larger gap are used.
#
# Where each value came from:
# bga_to_trace: 0.1mm (JLCPCB)
# castellated_min: 0.6mm (PCBWay)
# drill_hole_max: 6.3mm (JLCPCB, PCBWay)
# drill_hole_min: 0.15mm (JLCPCB, PCBWay)
# edge_routed: 0.3mm (PCBWay)
# implied_diff: 0.127mm (JLCPCB)
# implied_same_net: 0.254mm (JLCPCB)
# kelvin_annular: 0.125mm (JLCPCB)
# nonplated_slot_min: 1.0mm (JLCPCB)
# npth_annular: 0.45mm (JLCPCB)
# npth_hole_min: 0.5mm (JLCPCB, PCBWay)
# npth_to_copper: 0.2mm (JLCPCB, PCBWay)
# npth_to_trace: 0.254mm (PCBWay)
# pad_hole_diff: 0.5mm (PCBWay)
# pad_nohole_diff: 0.15mm (JLCPCB)
# pad_to_trace: 0.2mm (JLCPCB, PCBWay)
# plated_slot_min: 0.5mm (PCBWay)
# pth_annular: 0.254mm (JLCPCB)
# pth_hole_max: 6.3mm (JLCPCB)
# pth_hole_min: 0.2mm (PCBWay)
# pth_to_trace: 0.33mm (PCBWay)
# pth_to_trace_inner: 0.3mm (JLCPCB)
# same_net_trace_spacing: 0.25mm (JLCPCB)
# silk_clearance: 0.15mm (JLCPCB, PCBWay)
# small_via_diameter: 0.45mm (JLCPCB)
# small_via_hole: 0.3mm (JLCPCB)
# smd_pad_min: 0.125mm (JLCPCB)
# text_height: 1mm (JLCPCB)
# text_thickness: 0.15mm (JLCPCB, PCBWay)
# trace_spacing_inner: 0.1778mm (PCBWay)
# trace_spacing_outer: 0.1778mm (PCBWay)
# trace_width_inner: 0.1524mm (PCBWay)
# trace_width_outer: 0.1524mm (PCBWay)
# via_annular: 0.15mm (PCBWay)
# via_hole: 0.2mm (PCBWay)
# via_hole_diff: 0.5mm (PCBWay)
# via_pad_hole_diff: 0.5mm (PCBWay)
# via_same_net: 0.254mm (PCBWay)
# via_to_trace: 0.254mm (PCBWay)
#
# KiCad documentation: https://docs.kicad.org/8.0/en/pcbnew/pcbnew.html#custom-design-rules


# --- Drill/Hole Size ---

(rule "Generic: Drill Hole Size"
	(constraint hole_size (min 0.15mm) (max 6.3mm))
)

(rule "Generic: Via Hole Size"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.2mm))
)

(rule "Generic: Via Annular Ring"
	(condition "A.Type == 'Via'")
	(constraint annular_width (min 0.15mm))
)

# Comment out if extra cost is OK.
(rule "Generic: Via diameter < 0.45mm with hole < 0.3mm adds extra cost"
	(condition "(A.Type == 'Via') && (A.Hole < 0.3mm)")
	(constraint via_diameter (min 0.45mm))
)

(rule "Generic: PTH Hole Size"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.isPlated()")
	(constraint hole_size (min 0.2mm) (max 6.3mm))
)

(rule "Generic: NPTH Hole Size"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && !A.isPlated()")
	(constraint hole_size (min 0.5mm))
)

(rule "Generic: Castellated Hole Size"
	(condition "A.Type == 'Pad' && A.Fabrication_Property == 'Castellated pad'")
	(constraint hole_size (min 0.6mm))
)

(rule "Generic: PTH Annular Ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.isPlated()")
	(constraint annular_width (min 0.254mm))
)

(rule "Generic: NPTH Annular Ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && !A.isPlated()")
	(constraint annular_width (min 0.45mm))
)

# An expensive 4-Wire Kelvin Test is auto-added for holes < 0.3mm with diameter <= 0.4mm.
(rule "Generic: Avoid 4-Wire Kelvin Test"
	(condition "(A.Type == 'Via' && A.Hole < 0.3mm && A.Diameter <= 0.4mm) || (A.Type == 'Pad' && ((A.Hole_Size_X < 0.3mm && A.Size_X <= 0.4mm) || (A.Hole_Size_Y < 0.3mm && A.Size_Y <= 0.4mm)))")
	(constraint annular_width (min 0.125mm))
)


# --- Pad Size ---

# Generic's hard lower limit for an SMD pad. Their recommended
# minimum is larger; this only catches pads the fab cannot make.
(rule "Generic: SMD Pad Size"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'SMD' && (A.Size_X < 0.125mm || A.Size_Y < 0.125mm)")
	(constraint assertion "A.Size_X >= 0.125mm && A.Size_Y >= 0.125mm")
)


# --- VIA Support Rules ---

(rule "Generic: Only Throughhole VIAs are supported"
	(condition "A.Type == 'Via'")
	(constraint assertion "!(A.isBlindBuriedVia() || A.isMicroVia())")
)


# --- Slot Width ---

(rule "Generic: Plated Slot Width"
	(condition "A.Type == 'Pad' && (A.Hole_Size_X != A.Hole_Size_Y) && A.isPlated()")
	(constraint hole_size (min 0.5mm))
)

# JLCPCB: "The length of the slot should be at least 2 times of the width."
(rule "Generic: Plated Slot Length-to-width Ratio"
	(condition "(A.Type == 'Pad')")
	(constraint assertion "(A.Hole_Size_X == A.Hole_Size_Y) || (A.Hole_Size_X >= (2 * A.Hole_Size_Y)) || (A.Hole_Size_Y >= (2 * A.Hole_Size_X))")
)

(rule "Generic: Non-Plated Slot Width"
	(condition "A.Type == 'Pad' && (A.Hole_Size_X != A.Hole_Size_Y) && !A.isPlated()")
	(constraint hole_size (min 1.0mm))
)


# --- Minimum Clearance ---

(rule "Generic: Via Hole to Via Hole Clearance (Different Nets)"
	(condition "A.Type == 'Via' && B.Type == 'Via' && A.Net != B.Net")
	(constraint hole_to_hole (min 0.5mm))
)

(rule "Generic: Pad Hole to Pad Hole Clearance (Pad with Hole, Different Nets)"
	(condition "A.Type == 'Pad' && (A.Pad_Type == 'Through-hole' || A.Pad_Type == 'NPTH, mechanical') && B.Type == 'Pad' && (B.Pad_Type == 'Through-hole' || B.Pad_Type == 'NPTH, mechanical') && A.Net != B.Net")
	(constraint hole_to_hole (min 0.5mm))
)

# NOTE: KiCad applies the LAST matching rule, so the general "implied" rules below
# must come before the specific ones they would otherwise override.

# NOTE: This is not stated specifically, but is implied by other rules.
(rule "Generic: Via/Pad to Via/Pad Clearance (Different Nets)"
	(condition "(A.Type == 'Pad' || A.Type == 'Via') && (B.Type == 'Pad' || B.Type == 'Via') && A.Net != B.Net")
	(constraint clearance (min 0.127mm))
)

# NOTE: This is not stated specifically, but is implied by other rules.
(rule "Generic: Via/Pad Hole to Via/Pad Hole Clearance (Same Net)"
	(condition "(A.Type == 'Pad' || A.Type == 'Via') && (B.Type == 'Pad' || B.Type == 'Via') && A.Net == B.Net")
	(constraint hole_to_hole (min 0.254mm))
)

(rule "Generic: Via Hole to Via Hole Clearance (Same Net)"
	(condition "A.Type == 'Via' && B.Type == 'Via' && A.Net == B.Net")
	(constraint hole_to_hole (min 0.254mm))
)

# NOTE: Inferred from the pad-to-pad hole figure; not documented by the fab.
# A via and a plated pad on different nets are covered by neither the
# via-to-via nor the pad-to-pad hole spacing rule; the pair involves a pad
# hole, so the pad figure applies.
(rule "Generic: Via Hole to Pad Hole Clearance (Different Nets, inferred)"
	(condition "((A.Type == 'Via' && B.Type == 'Pad') || (A.Type == 'Pad' && B.Type == 'Via')) && A.Net != B.Net")
	(constraint hole_to_hole (min 0.5mm))
)

# Specific rule: must sit after the general clearance rule above to take effect.
(rule "Generic: Pad to Pad Clearance (Pad without Hole, Different Nets)"
	(condition "A.Type == 'Pad' && (A.Pad_Type != 'Through-hole' && A.Pad_Type != 'NPTH, mechanical') && B.Type == 'Pad' && (B.Pad_Type != 'Through-hole' && B.Pad_Type != 'NPTH, mechanical') && A.Net != B.Net")
	(constraint clearance (min 0.15mm))
)

(rule "Generic: Via to Trace"
	(condition "A.Type == 'Via' && B.Type == 'Track'")
	(constraint hole_clearance (min 0.254mm))
)

(rule "Generic: PTH to Trace"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.isPlated() && B.Type == 'Track'")
	(constraint hole_clearance (min 0.33mm))
)

(rule "Generic: PTH to Trace (inner layer)"
	(layer inner)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.isPlated() && B.Type == 'Track'")
	(constraint hole_clearance (min 0.3mm))
)

(rule "Generic: NPTH to Trace"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && !A.isPlated() && B.Type == 'Track'")
	(constraint hole_clearance (min 0.254mm))
)

(rule "Generic: NPTH to Copper (non-Track)"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && !A.isPlated() && B.Type != 'Track'")
	(constraint hole_clearance (min 0.2mm))
)

(rule "Generic: Pad to Trace"
	(condition "A.Type == 'Pad' && (A.Pad_Type == 'Through-hole' || A.Pad_Type == 'NPTH, mechanical') && B.Type == 'Track' && A.Net != B.Net")
	(constraint clearance (min 0.2mm))
)

# BGA fan-out clearance. Assign BGA fan-out nets to a 'BGA' net class.
(rule "Generic: BGA to Trace"
	(condition "A.NetClass == 'BGA' && B.Type == 'Track' && A.Net != B.Net")
	(constraint clearance (min 0.1mm))
)


# --- Minimum Trace Width and Spacing ---

(rule "Generic: Trace Width (Outer Layer)"
	(layer outer)
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.1524mm))
)

(rule "Generic: Trace Spacing (Outer Layer)"
	(layer outer)
	(condition "A.Type == 'Track' && B.Type == 'Track'")
	(constraint clearance (min 0.1778mm))
)

(rule "Generic: Trace Width (Inner Layer)"
	(layer inner)
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.1524mm))
)

(rule "Generic: Trace Spacing (Inner Layer)"
	(layer inner)
	(condition "A.Type == 'Track' && B.Type == 'Track'")
	(constraint clearance (min 0.1778mm))
)

# As of KiCad 9.0.8, this incorrectly flags any kind of connection
# between tracks (even if the track continues straight on and is just
# split into two parts with "Break Track").
# (rule "Generic: Same-net Trace Spacing"
# 	(condition "A.Type == 'Track' && B.Type == 'Track'")
# 	(constraint physical_clearance (min 0.25mm))
# )


# --- Impedance-Controlled Net Classes ---
#
# WARNING: trace width/gap for a target impedance depend on YOUR stackup
# (dielectric height, Dk, copper weight). The values below are typical
# starting points for your fab's default stackup — verify against
# your fab's impedance calculator for your actual order. Constraints use
# (opt ...) so they guide the router without raising nuisance DRC errors;
# tighten to (min/max) once tuned. Assign nets to these classes in
# Board Setup > Net Classes.

(rule "Generic: 50R Single-Ended"
	(condition "A.NetClass == '50R'")
	(constraint track_width (opt 0.2mm))
)

(rule "Generic: 60R_Diff Differential Pair"
	(condition "A.NetClass == '60R_Diff'")
	(constraint track_width (opt 0.3mm))
	(constraint diff_pair_gap (opt 0.15mm))
)

(rule "Generic: 90R_Diff Differential Pair"
	(condition "A.NetClass == '90R_Diff'")
	(constraint track_width (opt 0.2mm))
	(constraint diff_pair_gap (opt 0.13mm))
)

(rule "Generic: 100R_Diff Differential Pair"
	(condition "A.NetClass == '100R_Diff'")
	(constraint track_width (opt 0.2mm))
	(constraint diff_pair_gap (opt 0.2mm))
)

(rule "Generic: 120R_Diff Differential Pair"
	(condition "A.NetClass == '120R_Diff'")
	(constraint track_width (opt 0.15mm))
	(constraint diff_pair_gap (opt 0.2mm))
)


# --- Legend ---

(rule "Generic: Minimum Line Width"
	(layer "?.SilkS")
	(condition "A.Type == 'Text' || A.Type == 'Text Box'")
	(constraint text_thickness (min 0.15mm))
)

(rule "Generic: Minimum Text Height"
	(layer "?.SilkS")
	(condition "A.Type == 'Text' || A.Type == 'Text Box'")
	(constraint text_height (min 1mm))
)

(rule "Generic: Pad to Silkscreen"
	(condition "A.Type == 'Pad' && ((A.existsOnLayer('F.Mask') && B.Layer == 'F.SilkS') || (A.existsOnLayer('B.Mask') && B.Layer == 'B.SilkS'))")
	(constraint silk_clearance (min 0.15mm))
)


# --- Board Outlines ---

(rule "Generic: Trace to Board Edge"
	(condition "A.Type == 'Track'")
	(constraint edge_clearance (min 0.3mm))
)
